<div class="product-page">
  <div class="container">
    <div class="product-gallery">
      <div class="main-image">
        <img src="{{ product.featured_image.src }}" alt="{{ product.title }}">
      </div>
      <div class="thumbnail-images">
        {% for image in product.images %}
          <img src="{{ image.src | img_url: '100x100' }}" alt="{{ product.title }}">
        {% endfor %}
      </div>
    </div>
    
    <div class="product-info">
      <h1>{{ product.title }}</h1>
      
      <div class="rating">
        <span class="stars">★★★★★</span>
        <span class="review-count">({{ product.metafields.custom.review_count | default: '0' }} reviews)</span>
      </div>
      
      <div class="price">
        <span class="product-price">${{ product.price | money }}</span>
        {% if product.compare_at_price %}
          <span class="original-price">${{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>
      
      <div class="description">
        {{ product.description }}
      </div>
      
      <div class="benefits">
        <h3>Key Benefits</h3>
        <ul>
          <li>Premium quality ingredients</li>
          <li>Scientifically formulated</li>
          <li>Third-party tested</li>
          <li>No artificial additives</li>
        </ul>
      </div>
      
      <div class="product-options">
        <form method="post" action="/cart/add">
          <div class="quantity-selector">
            <label for="quantity">Quantity:</label>
            <input type="number" id="quantity" name="quantity" value="1" min="1">
          </div>
          
          <button type="submit" class="add-to-cart-btn">Add to Cart</button>
        </form>
        
        <button class="subscribe-btn">Subscribe & Save 15%</button>
      </div>
      
      <div class="product-details">
        <h3>Product Details</h3>
        <dl>
          <dt>Ingredients:</dt>
          <dd>{{ product.metafields.custom.ingredients | default: 'See label' }}</dd>
          <dt>Serving Size:</dt>
          <dd>{{ product.metafields.custom.serving_size | default: 'Consult label' }}</dd>
          <dt>SKU:</dt>
          <dd>{{ product.variants.first.sku }}</dd>
        </dl>
      </div>
      
      <div class="product-reviews">
        <h3>Customer Reviews</h3>
        <div class="reviews-list">
          <!-- Reviews would be loaded here -->
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .product-page {
    padding: 40px 0;
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  
  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  
  .main-image img {
    width: 100%;
    border-radius: 8px;
  }
  
  .thumbnail-images {
    display: flex;
    gap: 10px;
  }
  
  .thumbnail-images img {
    width: 100px;
    height: 100px;
    object-fit: cover;
    cursor: pointer;
    border-radius: 4px;
    border: 2px solid transparent;
  }
  
  .product-info h1 {
    font-size: 28px;
    margin-bottom: 15px;
  }
  
  .rating {
    margin-bottom: 15px;
  }
  
  .stars {
    color: #ffc107;
    font-size: 18px;
  }
  
  .price {
    margin: 20px 0;
    font-size: 24px;
    color: #333;
  }
  
  .original-price {
    text-decoration: line-through;
    color: #999;
    margin-left: 15px;
  }
  
  .benefits ul {
    list-style: none;
    margin: 20px 0;
  }
  
  .benefits li {
    padding: 8px 0;
    padding-left: 25px;
    position: relative;
  }
  
  .benefits li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #6c63ff;
    font-weight: bold;
  }
  
  .quantity-selector {
    margin: 20px 0;
  }
  
  .quantity-selector input {
    width: 70px;
    padding: 8px;
    margin-left: 10px;
  }
  
  .add-to-cart-btn {
    width: 100%;
    padding: 15px;
    background: #6c63ff;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 16px;
    cursor: pointer;
    margin: 15px 0;
  }
  
  .add-to-cart-btn:hover {
    background: #5a54d4;
  }
  
  .subscribe-btn {
    width: 100%;
    padding: 12px;
    background: #f0f0f0;
    border: 2px solid #6c63ff;
    color: #6c63ff;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 500;
  }
  
  .product-details {
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid #e0e0e0;
  }
  
  .product-details dl {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 20px;
    margin-top: 15px;
  }
  
  .product-details dt {
    font-weight: 600;
  }
</style>
