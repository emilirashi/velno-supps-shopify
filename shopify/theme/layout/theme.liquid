<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if page_title %}{{ page_title }} | {% endif %}{{ shop.name }}</title>
  <link rel="stylesheet" href="{{ 'styles.css' | asset_url }}">
  {{ content_for_header }}
</head>
<body>
  {% section 'header' %}
  
  <main role="main">
    {{ content_for_layout }}
  </main>
  
  {% section 'footer' %}
  
  <script src="{{ 'theme.js' | asset_url }}"></script>
</body>
</html>
